# Java
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# IDEA / VS Code
.idea/
*.iml
.vscode/

# Node
node_modules/
dist/
*.local

# 本机环境配置(含密码)
cinema-server/src/main/resources/application-dev.yml

# 日志与其他
logs/
*.log
.DS_Store

# 本地工具配置
.claude/
.zcode/
.workbuddy/
# ZCode 自动生成的忽略文件(其内容是 .gitignore 的同步快照, 随工具重写, 不入库)
.zcodeignore

# Playwright CLI 测试临时产物
test/playwright-cli/.playwright-cli/
test/playwright-cli/screenshots/
test/playwright-cli/check_*.sql
test/playwright-cli/check_*.js
test/playwright-cli/expire_*.sql
test/playwright-cli/redis_*.txt
test/playwright-cli/_lib.ps1
test/playwright-cli/logs/
test/playwright-cli/scenarios/
# a11y 树快照: 一次性快照不入库; 已跟踪的 6 个基准快照 (s01/s02/s03/s06-*.yml) 保持跟踪
# (gitignore 只作用于未跟踪文件, 不会 untrack 已入库的基准快照)
test/playwright-cli/snapshots/

# playwright-cli 默认把快照写到 git root (如 404.yml / home-full.yml / login2.yml),
# 会持续污染仓库根目录。已统一归档到 test/playwright-cli/snapshots/, 此规则挡住再次堆积。
# 本仓库无根级 .yml 配置 (application.yml 在 cinema-server/src/main/resources/),
# 故 / 前缀仅匹配根目录是安全的; 若将来引入 docker-compose.yml 等根配置, 需改成带 ! 例外的精确规则。
/*.yml

# E2E 测试内容 (顶层 test/ tests/ 目录; 不影响 cinema-server/src/test/ 等子模块测试目录)
# / 前缀强制仅匹配 git root; 避免误伤 cinema-server/src/test/
#
# v0.4.0: 浏览器回归套件**要入库** —— 证据必须入库才算数(新克隆的仓库拿不到就等于没有)。
# 注意 gitignore 的语义: 父目录被排除时无法重新包含子目录, 所以这里排除的是
# 「test/ 里的东西」(/test/*), 而不是 test/ 目录本身, 再单独开 test/e2e/ 的口子。
/test/*
/tests/*
!test/e2e/
test/e2e/screenshots/
test/e2e/__pycache__/
# 2026-09-29 的 E2E 报告是「问题闭环」的历史证据, 随仓库入库
!test/e2e-report-2026-09-29.md
# 测试报告
docs/压测报告*.md
# README 与实现方案都引用了这两份压测报告, 它们是「并发 0 超卖」这类正确性证据,
# 属于交付物而非临时产物 —— 解除忽略, 随仓库入库。上面的规则继续挡住同前缀的新报告。
!docs/压测报告.md
!docs/压测报告-v2.md
# v0.4.0: 一键演示脚本生成的最新压测报告(同属交付证据)
!docs/压测报告-v3.md
test_mixed.py
test_myorders.py
test_webapp_e2e.py
verify_lock.py
_report.json
_report_*.png
.playwright-cli/
.playwright/
cinema-server/.factorypath

# 本地产物/临时目录
.scratch/
META-INF/
cinema-server/.tmp/
opennlp/

# v0.4.0: 另一个项目的 Mini App 目录(defect-triage-workbench)已**移出本仓库**
# (到 F:\test\miniapps-defect-triage-workbench), 所以这里不再需要它的忽略规则。

# 课程设计汇报物料 (一次性交付素材, 不属于 cinema 业务代码)
# deck/  —— 汇报幻灯片生成器与产物 (PPTX / 图片 / 中间文件)
# video/ —— 汇报演示前端 + 配音流水线 + 成片, 含约 44MB 的 mp3/音频二进制
#
# v0.4.0: deck/ 的**生成器源码**入库(约 80KB), 让「怎么重新生成」有据可查;
# 产物(2.3MB 的 PPTX / PDF / 33 张 PNG)继续忽略 —— 它们可由源码重新生成,
# 入库只会永久撑大仓库。同样是「排除内容而非排除目录」, 才能重新包含子项。
# ⚠️ 源码实际在 deck/slides/ 下(不是 deck/ 根目录) —— 否定规则必须写对路径,
#    写错了会**静默不生效**(2026-10-25 实测踩到: 规则写成 deck/compile.js,
#    结果 deck/slides/compile.js 仍被 /deck/* 挡住, 源码根本没入库,
#    而发布说明却声称「生成器源码入库」—— 文档说有、代码没有)。
/deck/*
!deck/README.md
!deck/slides/
/deck/slides/output/
/video/
