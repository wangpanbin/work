# Java
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# IDEA / VS Code
.idea/
*.iml
.vscode/

# Node
node_modules/
dist/
*.local

# 本机环境配置(含密码)
cinema-server/src/main/resources/application-dev.yml

# 日志与其他
logs/
*.log
.DS_Store

# 本地工具配置
.claude/
.zcode/
# ZCode 自动生成的忽略文件(其内容是 .gitignore 的同步快照, 随工具重写, 不入库)
.zcodeignore

# Playwright CLI 测试临时产物
test/playwright-cli/.playwright-cli/
test/playwright-cli/screenshots/
test/playwright-cli/check_*.sql
test/playwright-cli/check_*.js
test/playwright-cli/expire_*.sql
test/playwright-cli/redis_*.txt
test/playwright-cli/_lib.ps1
test/playwright-cli/logs/
test/playwright-cli/scenarios/
# a11y 树快照: 一次性快照不入库; 已跟踪的 6 个基准快照 (s01/s02/s03/s06-*.yml) 保持跟踪
# (gitignore 只作用于未跟踪文件, 不会 untrack 已入库的基准快照)
test/playwright-cli/snapshots/

# playwright-cli 默认把快照写到 git root (如 404.yml / home-full.yml / login2.yml),
# 会持续污染仓库根目录。已统一归档到 test/playwright-cli/snapshots/, 此规则挡住再次堆积。
# 本仓库无根级 .yml 配置 (application.yml 在 cinema-server/src/main/resources/),
# 故 / 前缀仅匹配根目录是安全的; 若将来引入 docker-compose.yml 等根配置, 需改成带 ! 例外的精确规则。
/*.yml

# E2E 测试内容 (顶层 test/ tests/ 目录; 不影响 cinema-server/src/test/ 等子模块测试目录)
# / 前缀强制仅匹配 git root; 避免误伤 cinema-server/src/test/
/test/
/tests/
# 测试报告
docs/压测报告*.md
test_mixed.py
test_myorders.py
test_webapp_e2e.py
verify_lock.py
_report.json
_report_*.png
.playwright-cli/
.playwright/
cinema-server/.factorypath

# 本地产物/临时目录
.scratch/
META-INF/
cinema-server/.tmp/
opennlp/

# 课程设计汇报物料 (一次性交付素材, 不属于 cinema 业务代码)
# deck/  —— 汇报幻灯片生成器与产物 (PPTX / 图片 / 中间文件)
# video/ —— 汇报演示前端 + 配音流水线 + 成片, 含约 44MB 的 mp3/音频二进制
# 二者均可由脚本重新生成, 入库只会永久撑大仓库且污染业务代码的 diff。
# / 前缀限定仅匹配 git root, 避免误伤子模块内同名目录。
/deck/
/video/
